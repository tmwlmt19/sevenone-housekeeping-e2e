# Copy to `.env` (gitignored) and fill in. `.env` holds the Neon e2e branch DSN
# and the e2e admin password — treat it as a secret, never commit it.

# --- App origins (local dev defaults; must match each app's own .env.local) ---
E2E_API_URL=http://localhost:8000
E2E_LOGIN_URL=http://localhost:5174
E2E_WEB_URL=http://localhost:5173
E2E_ADMIN_URL=http://localhost:5175

# --- The Neon `e2e` branch (isolated, disposable copy of the DB) ---
# libpq form (used by the `pg` client in tests for token minting + assertions).
# The backend receives this same DSN as DATABASE_URL (it normalizes to asyncpg).
# Get it from: Neon console → project sevenone-housekeeping-db → branch `e2e`.
E2E_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# JWT secret the e2e backend signs cookies with (any random string; e2e-only).
E2E_JWT_SECRET=e2e-test-secret-not-for-production

# --- The seeded platform (service) admin the suite provisions hotels as ---
E2E_ADMIN_EMAIL=admin@e2e-sevenone.com
E2E_ADMIN_PASSWORD=E2eAdmin123!

# Optional: override where the backend repo lives (defaults to the sibling
# ../sevenone-housekeeping-service). Used to boot uvicorn.
# E2E_SERVICE_DIR=/absolute/path/to/sevenone-housekeeping-service
